# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.venv/
venv/
env/
ENV/

# Coverage / testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Docker
*.dockerignore

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Alembic temp
*.pyc

# Database local files
*.db
*.sqlite
*.sqlite3

# Storage (local dev — repositories & artifacts stored here)
storage/
