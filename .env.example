# ─────────────────────────────────────────────
# LEGACYX — Environment Variable Reference
# Copy to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ─── Application ───────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret

# ─── Database ──────────────────────────────
POSTGRES_USER=legacyx
POSTGRES_PASSWORD=legacyx_dev_password
POSTGRES_DB=legacyx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Constructed by backend from above:
# DATABASE_URL=postgresql+asyncpg://legacyx:legacyx_dev_password@postgres:5432/legacyx
DATABASE_URL=postgresql+asyncpg://legacyx:legacyx_dev_password@postgres:5432/legacyx

# Sync URL used by Alembic only (psycopg2 driver):
DATABASE_SYNC_URL=postgresql+psycopg2://legacyx:legacyx_dev_password@postgres:5432/legacyx

# ─── Redis ─────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Storage ───────────────────────────────
# Local filesystem path for repository archives and generated artifacts.
# In production this will be replaced by an S3-compatible URL.
STORAGE_ROOT=/app/storage

# ─── CORS ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# ─── Logging ───────────────────────────────
LOG_LEVEL=INFO

# ─── JWT (Phase 1: placeholder, authentication wired in Phase 2+) ───
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI (Phase 4+: leave blank for now) ───
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=
